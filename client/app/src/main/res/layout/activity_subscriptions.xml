<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:padding="10dp"
    tools:context=".SubscriptionsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginHorizontal="10dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="10dp"
            android:padding="5dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/back"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/subscription_activity_title"
                android:rotation="180"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#929997" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="0dp"
                android:fontFamily="@font/jost_extrabold"
                android:text="@string/subscription_activity_title"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- TOGGLE NAV -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/togglePlansTimingContainer"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_pill"
            android:padding="4dp">
            <!-- Sliding indicator -->
            <View
                android:id="@+id/tabIndicator"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/toggle_indicator_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.5" />
            <!-- Monthly -->
            <TextView
                android:id="@+id/tvMonthly"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:fontFamily="@font/jost_semibold"
                android:gravity="center"
                android:text="@string/plan_timing_tab_item_1"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvYearly"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <!-- Yearly -->
            <TextView
                android:id="@+id/tvYearly"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:fontFamily="@font/jost_semibold"
                android:gravity="center"
                android:text="@string/plan_timing_tab_item_2"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvMonthly"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- HORIZONTAL PAGINATION -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/cardPositionDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/togglePlansTimingContainer"
                tools:ignore="NotSibling" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pricingCardsPager"
                android:layout_width="match_parent"
                android:layout_height="580dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardPositionDots"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


</RelativeLayout>