<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pricing_card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/semi_rounded_button_bg"
        android:backgroundTint="#8A2704"
        android:gravity="center|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/jost_medium"
            android:text="@string/plan_label_1"
            android:textAllCaps="true"
            android:textColor="#CCC"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/savingsValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jost_semibold"
            android:textColor="@color/white"
            android:textSize="16.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="15dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_plan_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/jost_medium"
            android:paddingHorizontal="10dp"
            android:textColor="#FFEB3B"
            android:textSize="23sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost_extrabold"
                android:textColor="@color/white"
                android:textSize="40sp" />
            <TextView
                android:id="@+id/timingType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="0dp"
                android:fontFamily="@font/jost_medium"
                android:textColor="#CCC"
                android:textSize="21sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/featuresList"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="25dp"
            android:fastScrollAlwaysVisible="false"
            android:fastScrollEnabled="false"
            android:scrollIndicators="none"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </LinearLayout>

    <Button
        android:id="@+id/ctaBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#FDF8F0"
        android:fontFamily="@font/jost_bold"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/cta_btn_text"
        android:textColor="@color/black"
        android:textColorLink="@color/black"
        android:textSize="19sp" />

</LinearLayout>