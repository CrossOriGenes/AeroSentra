<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="30dp">

    <LinearLayout
        android:id="@+id/btn_saveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/semi_rounded_button_bg"
        android:backgroundTint="#12919E"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/actions_btn_1"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_save"
            app:tint="#B0E9ED" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="0dp"
            android:fontFamily="@font/jost_semibold"
            android:text="@string/actions_btn_1"
            android:textColor="@color/white"
            android:textColorLink="@color/white"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/semi_rounded_outline_btn"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">
        <ImageView
            android:layout_width="35dp"
            android:layout_height="20dp"
            android:contentDescription="@string/actions_btn_2"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_exit"
            app:tint="#F45A83" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="0dp"
            android:fontFamily="@font/jost_semibold"
            android:text="@string/actions_btn_2"
            android:textColor="#6F0726"
            android:textColorLink="#6F0726"
            android:textSize="21sp" />
    </LinearLayout>

</LinearLayout>