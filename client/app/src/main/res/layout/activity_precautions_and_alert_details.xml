<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".PrecautionsAndAlertDetailsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/alert_details_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp"
            android:layout_marginTop="10dp">
            <ImageView
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/alert_details_title"
                android:rotation="180"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#666" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="0dp"
                android:fontFamily="@font/jost_extrabold"
                android:gravity="center"
                android:text="@string/alert_details_title"
                android:textColor="#4D4D4D"
                android:textSize="22sp" />
        </LinearLayout>
        <!-- ALERT DETAILS -->
        <include layout="@layout/alert_details_card" />
        <!-- DETAILS NOT-GENERATED FALLBACK -->
        <LinearLayout
            android:id="@+id/alert_details_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="95dp"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingVertical="15dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/alert_details_header">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost_semibold"
                android:gravity="center"
                android:text="@string/alert_details_not_found_title"
                android:textColor="#AAA"
                android:textSize="16sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jost_regular"
                android:gravity="center"
                android:lineSpacingExtra="-6dp"
                android:text="@string/alert_details_not_found_description"
                android:textColor="#F0830E"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>
        <!-- AQI & UV SEVERITY -->
        <include
            layout="@layout/aqi_analytic_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/alert_detailed_report_card"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="35dp" />
        <include
            layout="@layout/uv_analytic_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/aqi_analytic_section"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="100dp" />
    </RelativeLayout>

</ScrollView>