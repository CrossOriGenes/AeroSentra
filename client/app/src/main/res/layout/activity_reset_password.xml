<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ResetPasswordActivity">

    <FrameLayout
        android:id="@+id/backBtn2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="62dp"
        android:background="@drawable/semi_rounded_outline_btn"
        android:padding="5dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/request_password_change_title"
            android:rotation="180"
            android:scaleType="center"
            android:scaleX="1.15"
            android:scaleY="1.15"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/black" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="220dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jost_extrabold"
            android:text="@string/reset_password_title"
            android:textColor="#222"
            android:textSize="35sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/jost_medium"
            android:lineSpacingExtra="-4dp"
            android:text="@string/reset_password_description"
            android:textColor="#858A8C"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/password_new"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="password"
                android:background="@drawable/input_box_bg"
                android:fontFamily="@font/jost_medium"
                android:hint="@string/new_password_hint_1"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textColorHint="#999"
                android:textSize="19sp" />
            <ImageButton
                android:id="@+id/toggle_pass_visibility_btn_3"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="-60dp"
                android:layout_marginEnd="0dp"
                android:background="@null"
                android:contentDescription="@string/new_password_hint_1"
                android:scaleType="center"
                android:src="@drawable/ic_eye"
                app:tint="#777" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/password_new_confirm"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="password"
                android:background="@drawable/input_box_bg"
                android:fontFamily="@font/jost_medium"
                android:hint="@string/new_password_hint_2"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textColorHint="#999"
                android:textSize="19sp" />
            <ImageButton
                android:id="@+id/toggle_pass_visibility_btn_4"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="-60dp"
                android:layout_marginEnd="0dp"
                android:background="@null"
                android:contentDescription="@string/new_password_hint_2"
                android:scaleType="center"
                android:src="@drawable/ic_eye"
                app:tint="#777" />
        </LinearLayout>


        <TextView
            android:id="@+id/errMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="-15dp"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/jost_mediumitalic"
            android:textColor="#F00"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/save_new_password_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:backgroundTint="@color/black"
            android:fontFamily="@font/jost_medium"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/button_save_text"
            android:textColor="@color/white"
            android:textColorLink="@color/white"
            android:textSize="20sp" />

    </LinearLayout>

</RelativeLayout>