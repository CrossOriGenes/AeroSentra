<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/forecastDailyDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jost_medium"
            android:textColor="#ccc"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/forecastDailyIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:contentDescription="@string/content_1_title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginHorizontal="10dp">
            <TextView
                android:id="@+id/forecastDailyMaxTemp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/jost_semibold"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="23sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="@string/content_1_temperature_separator"
                android:textColor="#ccc"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/forecastDailyMinTemp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fontFamily="@font/jost_medium"
                android:gravity="center_vertical"
                android:textColor="#C3C3C3"
                android:textSize="21sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/forecastDailyDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jost_regular"
            android:textColor="#777"
            android:textSize="14sp" />

    </LinearLayout>

    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#444"
        android:layout_gravity="center"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="15dp" />

</LinearLayout>
