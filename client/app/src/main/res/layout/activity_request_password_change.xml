<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RequestPasswordChangeActivity">

    <FrameLayout
        android:id="@+id/backBtn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="62dp"
        android:background="@drawable/semi_rounded_outline_btn"
        android:padding="5dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/request_password_change_title"
            android:rotation="180"
            android:scaleType="center"
            android:scaleX="1.15"
            android:scaleY="1.15"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/black" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="220dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jost_extrabold"
            android:text="@string/request_password_change_title"
            android:textColor="#222"
            android:textSize="35sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/jost_medium"
            android:lineSpacingExtra="-4dp"
            android:text="@string/request_password_change_description"
            android:textColor="#858A8C"
            android:textSize="17sp" />

        <EditText
            android:id="@+id/email_for_reset_link"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/input_box_bg"
            android:fontFamily="@font/jost_medium"
            android:hint="@string/signup_hint_2"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textColorHint="#999"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/errMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="-15dp"
            android:layout_marginEnd="5dp"
            android:fontFamily="@font/jost_mediumitalic"
            android:textColor="#F00"
            android:textSize="15sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/verifyAndSendResetLinkBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:backgroundTint="@color/black"
            android:fontFamily="@font/jost_medium"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/button_verify_text"
            android:textColor="@color/white"
            android:textColorLink="@color/white"
            android:textSize="20sp" />

    </LinearLayout>

</RelativeLayout>