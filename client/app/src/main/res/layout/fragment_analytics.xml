<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <!-- DAILY FORECAST -->
        <include layout="@layout/daily_forecast_list_section" />
        <!-- HOURLY FORECAST -->
        <include layout="@layout/hourly_forecast_list_section" />
        <!-- TEMPERATURE ANALYTICS CHART -->
        <include layout="@layout/temperature_analytic_chart" />
        <!-- HUMIDITY ANALYTICS CHART -->
        <include layout="@layout/humidity_analytic_chart" />
        <!-- RAINFALL ANALYTICS CHART -->
        <include layout="@layout/rainfall_analytic_chart" />
        <!-- AQI ANALYTICS SECTION -->
        <include layout="@layout/aqi_analytic_section" />

    </LinearLayout>
</ScrollView>